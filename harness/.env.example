# 하네스 환경 설정
# 이 파일을 .env로 복사 후 값 입력: cp .env.example .env

# ── API 서버 ──────────────────────────────
PORT=3000
API_KEY=your-secret-api-key-here

# ── 텔레그램 ──────────────────────────────
# 기존 VPS 봇의 토큰과 동일하게 사용
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── 프로젝트 경로 (로컬 Mac 기준) ─────────
PROJECTS_ROOT=/Users/sun

# ── Claude Code ───────────────────────────
# claude CLI 경로 (which claude 로 확인)
CLAUDE_CLI_PATH=/usr/local/bin/claude

# ── 하네스 설정 ───────────────────────────
# 동시 실행 가능한 최대 에이전트 수
MAX_CONCURRENT_AGENTS=2
# 평가 최대 라운드 수
MAX_EVAL_ROUNDS=3
