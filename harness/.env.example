# 하네스 환경 설정
# 이 파일을 .env로 복사 후 값 입력: cp .env.example .env
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 등록됨)

# ── API 서버 ──────────────────────────────────────────────────
PORT=3000

# API_KEY: 최소 32자 랜덤 문자열 필수
# 생성 방법: openssl rand -hex 32
API_KEY=

# 대시보드 접근을 허용할 Origin (예: https://your-dashboard.com)
# 로컬 개발 시 비워두면 localhost:5173만 허용
ALLOWED_ORIGIN=

# ── 텔레그램 ──────────────────────────────────────────────────
# BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=

# 텔레그램 채팅 ID (숫자만, @userinfobot 으로 확인)
TELEGRAM_CHAT_ID=

# ── 프로젝트 경로 ─────────────────────────────────────────────
# 허용할 프로젝트 루트 경로 (콤마로 여러 개 지정 가능)
# 이 경로 외의 디렉토리는 에이전트가 접근할 수 없음
PROJECTS_ROOT=/Users/sun

# ── Claude Code ───────────────────────────────────────────────
# claude CLI 절대 경로 (which claude 로 확인)
CLAUDE_CLI_PATH=/usr/local/bin/claude

# Claude API 키 (claude CLI가 내부적으로 사용)
ANTHROPIC_API_KEY=

# ── 하네스 설정 ───────────────────────────────────────────────
# 동시 실행 가능한 최대 에이전트 수 (VPS 메모리 고려)
MAX_CONCURRENT_AGENTS=2

# 평가 최대 라운드 수 (비용 절약을 위해 낮게 유지)
MAX_EVAL_ROUNDS=3
