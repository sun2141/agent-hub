# 하네스 환경 설정
# 이 파일을 .env로 복사 후 값 입력: cp .env.example .env
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 등록됨)

# ── API 서버 ──────────────────────────────────────────────────
PORT=3000

# ── Neon DB ───────────────────────────────────────────────────
# 하네스 운영 DB. Neon의 pooled connection string(-pooler 호스트)을 사용하세요.
NEON_DATABASE_URL=

# API_KEY: 최소 32자 랜덤 문자열 필수
# 생성 방법: openssl rand -hex 32
API_KEY=

# 대시보드 접근을 허용할 Origin (예: https://your-dashboard.com)
# 로컬 개발 시 비워두면 localhost:5173만 허용
ALLOWED_ORIGIN=

# ── 텔레그램 ──────────────────────────────────────────────────
# BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=

# 텔레그램 채팅 ID (숫자만, @userinfobot 으로 확인)
TELEGRAM_CHAT_ID=

# ── 프로젝트 경로 ─────────────────────────────────────────────
# 허용할 프로젝트 루트 경로 (콤마로 여러 개 지정 가능)
# 이 경로 외의 디렉토리는 에이전트가 접근할 수 없음
PROJECTS_ROOT=/home/agent/workspace

# ── Claude Code ───────────────────────────────────────────────
# claude CLI 절대 경로 (which claude 로 확인)
CLAUDE_CLI_PATH=/usr/local/bin/claude

# Claude API 키 (claude CLI가 내부적으로 사용)
ANTHROPIC_API_KEY=

# ── Codex CLI ────────────────────────────────────────────────
# ChatGPT 구독(Plus) 인증. `which codex` 결과로 설정하세요.
# 인증: ~/.codex/auth.json (제자리 갱신 — 병렬 실행 금지, 백업 보존).
CODEX_CLI_PATH=codex

# ── Antigravity CLI (agy) ─────────────────────────────────────
# Google AI Pro 인증. Gemini CLI 개인용 종료(2026-06-18) 후속 도구.
# `which agy` 결과로 설정. 인증: OAuth 디바이스 코드 1회 → 키링 캐시.
# ⚠️ 무인 운영 전 키링 잠금 해제 필요: bash scripts/setup-antigravity-keyring.sh
AGY_CLI_PATH=agy
# 사용할 모델(선택). 비우면 agy 기본값. 예: gemini-3-pro
AGY_MODEL=

# ── 멀티 프로바이더 오케스트레이션 ────────────────────────────
# true일 때만 3-프로바이더 로테이션/대기 경로 활성화. 미설정/false면 기존 동작 유지.
MULTI_PROVIDER=false

# 단계별 선호 프로바이더 (핀 고정: plan/review, 페일오버: build/testfix)
PROVIDER_PLAN=antigravity
PROVIDER_BUILD=claude
PROVIDER_REVIEW=codex

# weekly 캡(며칠 정지)일 때 핀 고정 단계도 강등 허용 (다일 정지 회피)
PROVIDER_RELAX_WEEKLY=true

# ── 하네스 설정 ───────────────────────────────────────────────
# 동시 실행 가능한 최대 에이전트 수 (VPS 메모리 고려)
MAX_CONCURRENT_AGENTS=2

# 평가 최대 라운드 수 (eval 성공 시 조기 종료, 실패 시 최대까지 재시도)
# 작업 복잡도(기능 수 + 완료 기준 수)에 따라 자동 상향 조정될 수 있음
MAX_EVAL_ROUNDS=10

# 검증 게이트에서 scripts.test/scripts.smoketest 실행 타임아웃(ms).
# typecheck/lint/build는 300000(5분) 고정, 테스트만 이 값 사용 — 기본 10분.
VERIFY_TEST_TIMEOUT_MS=600000

# ── 자동 커밋/배포 설정 ───────────────────────────────────────
# eval 합격 시 배포 방법 선택: push | pm2 | script | none
# push   : git push만 수행 (harness self-kill 방지 권장값)
# pm2    : PM2로 앱을 reload
# script : DEPLOY_HOOK_PATH에 지정한 셸 스크립트 실행
# none   : 커밋만 하고 배포는 건너뜀
DEPLOY_METHOD=push

# pm2 앱 이름 (DEPLOY_METHOD=pm2 일 때 사용)
PM2_APP_NAME=harness

# 사용자 정의 배포 훅 경로 (DEPLOY_METHOD=script 일 때 사용)
# 예: /home/ubuntu/scripts/deploy-hook.sh
DEPLOY_HOOK_PATH=

# ── 매니저 루프 (백로그 제안→승인→실행, 기본 off) ──────────────
# true일 때만 /scan /backlog /approve /reject /rollback 텔레그램 명령 활성화.
# 미설정/false면 기존 파이프라인/명령은 전부 그대로 동작(additive).
MANAGER_LOOP=false

# 동시에 진행 가능한 매니저 승인 작업(branchMode) 수
MANAGER_MAX_CONCURRENT=1

# 하루 승인 상한 (UTC 기준)
MANAGER_MAX_APPROVALS_PER_DAY=3

# 매니저의 "다음 작업 제안" LLM 1회 호출 타임아웃(ms)
MANAGER_LLM_TIMEOUT_MS=120000

# ── 의도 신호 게이트 (자기참조 잡일 루프 방지) ─────────────────
# 신호는 두 종류다:
#   의도 신호  — directives/projects/<id>.md 의 "## Backlog" 섹션, GitHub 이슈
#                (사람이 "이걸 하고 싶다"고 적은 것)
#   이력 신호  — 하네스 자신의 needs_review/failed 작업 (자기참조)
#
# true(기본): 의도 신호가 하나도 없는 프로젝트는 제안 자체를 하지 않는다.
#   → 하네스가 자기 실패 이력만 보고 뒤치다꺼리 작업을 만들어내는 걸 막는다.
#   → 제안을 받고 싶으면 Backlog 섹션에 항목을 적거나 GitHub 이슈를 연다.
# false: 이력 신호만으로도 제안 허용 (잡일 생성 위험).
MANAGER_REQUIRE_INTENT_SIGNAL=true

# 프롬프트에 넣을 이력 신호 최대 개수. 의도 신호(최대 8)를 밀어내지 않도록 소수로 둔다.
MANAGER_MAX_HISTORY_SIGNALS=3

# ── 자동 스캔 (제안까지만 자동화 — 승인/병합은 항상 사람) ──────
# 자동 스캔 주기(분). 0 또는 미설정이면 자동 스캔 없음(/scan 수동만).
# MANAGER_LOOP=true 여야 동작한다. 권장 시작값: 180 (3시간)
MANAGER_SCAN_INTERVAL_MIN=0

# 스캔하지 않을 시간대 "시작-끝" (24h, 서버 로컬 시간, 끝 시각 배타적).
# 예: 23-8 → 23시부터 다음날 7시대까지 스캔 안 함. 비우면 항상 스캔.
MANAGER_SCAN_QUIET_HOURS=23-8

# 미결(proposed) 제안이 이 개수 이상 쌓이면 자동 스캔을 건너뛴다.
# 승인되지 않은 제안이 쌓인 상태에서 LLM 비용만 계속 쓰는 걸 막는 안전장치.
MANAGER_MAX_PENDING=10

# 새 제안이 0건일 때도 텔레그램 알림을 보낼지 (기본 false — 조용히 넘어감)
MANAGER_SCAN_NOTIFY_EMPTY=false

# 매니저 승인 작업(/approve)이 PR을 열려면 gh CLI가 인증되어 있어야 함:
#   gh auth login  (repo 스코프 필요, 실행 계정에서 1회)
# gh pr merge는 하네스 코드 어디에도 없음 — 병합은 항상 사용자가 수동으로.

# ── Node 바이너리 경로 ──────────────────────────────────────
# scripts/start.sh와 scripts/deploy_detached.sh가 사용
# 비워두면 PATH의 node를 사용 (command -v node)
# nvm 사용자는 절대경로 권장: /Users/sun/.nvm/versions/node/vXX.YY.ZZ/bin/node
NODE_BIN=
