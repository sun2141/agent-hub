# 하네스 환경 설정
# 이 파일을 .env로 복사 후 값 입력: cp .env.example .env
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 등록됨)

# ── API 서버 ──────────────────────────────────────────────────
PORT=3000

# ── Neon DB ───────────────────────────────────────────────────
# 하네스 운영 DB. Neon의 pooled connection string(-pooler 호스트)을 사용하세요.
NEON_DATABASE_URL=

# API_KEY: 최소 32자 랜덤 문자열 필수
# 생성 방법: openssl rand -hex 32
API_KEY=

# 대시보드 접근을 허용할 Origin (예: https://your-dashboard.com)
# 로컬 개발 시 비워두면 localhost:5173만 허용
ALLOWED_ORIGIN=

# ── 텔레그램 ──────────────────────────────────────────────────
# BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=

# 텔레그램 채팅 ID (숫자만, @userinfobot 으로 확인)
TELEGRAM_CHAT_ID=

# ── 프로젝트 경로 ─────────────────────────────────────────────
# 허용할 프로젝트 루트 경로 (콤마로 여러 개 지정 가능)
# 이 경로 외의 디렉토리는 에이전트가 접근할 수 없음
PROJECTS_ROOT=/home/agent/workspace

# ── Claude Code ───────────────────────────────────────────────
# claude CLI 절대 경로 (which claude 로 확인)
CLAUDE_CLI_PATH=/usr/local/bin/claude

# Claude API 키 (claude CLI가 내부적으로 사용)
ANTHROPIC_API_KEY=

# ── Codex CLI ────────────────────────────────────────────────
# ChatGPT 구독(Plus) 인증. `which codex` 결과로 설정하세요.
# 인증: ~/.codex/auth.json (제자리 갱신 — 병렬 실행 금지, 백업 보존).
CODEX_CLI_PATH=codex

# ── Antigravity CLI (agy) ─────────────────────────────────────
# Google AI Pro 인증. Gemini CLI 개인용 종료(2026-06-18) 후속 도구.
# `which agy` 결과로 설정. 인증: OAuth 디바이스 코드 1회 → 키링 캐시.
# ⚠️ 무인 운영 전 키링 잠금 해제 필요: bash scripts/setup-antigravity-keyring.sh
AGY_CLI_PATH=agy
# 사용할 모델(선택). 비우면 agy 기본값. 예: gemini-3-pro
AGY_MODEL=

# ── 멀티 프로바이더 오케스트레이션 ────────────────────────────
# true일 때만 3-프로바이더 로테이션/대기 경로 활성화. 미설정/false면 기존 동작 유지.
MULTI_PROVIDER=false

# 단계별 선호 프로바이더 (핀 고정: plan/review, 페일오버: build/testfix)
PROVIDER_PLAN=antigravity
PROVIDER_BUILD=claude
PROVIDER_REVIEW=codex

# weekly 캡(며칠 정지)일 때 핀 고정 단계도 강등 허용 (다일 정지 회피)
PROVIDER_RELAX_WEEKLY=true

# ── 하네스 설정 ───────────────────────────────────────────────
# 동시 실행 가능한 최대 에이전트 수 (VPS 메모리 고려)
MAX_CONCURRENT_AGENTS=2

# 평가 최대 라운드 수 (eval 성공 시 조기 종료, 실패 시 최대까지 재시도)
# 작업 복잡도(기능 수 + 완료 기준 수)에 따라 자동 상향 조정될 수 있음
MAX_EVAL_ROUNDS=10

# ── 자동 커밋/배포 설정 ───────────────────────────────────────
# eval 합격 시 배포 방법 선택: push | pm2 | script | none
# push   : git push만 수행 (harness self-kill 방지 권장값)
# pm2    : PM2로 앱을 reload
# script : DEPLOY_HOOK_PATH에 지정한 셸 스크립트 실행
# none   : 커밋만 하고 배포는 건너뜀
DEPLOY_METHOD=push

# pm2 앱 이름 (DEPLOY_METHOD=pm2 일 때 사용)
PM2_APP_NAME=harness

# 사용자 정의 배포 훅 경로 (DEPLOY_METHOD=script 일 때 사용)
# 예: /home/ubuntu/scripts/deploy-hook.sh
DEPLOY_HOOK_PATH=

# ── Node 바이너리 경로 ──────────────────────────────────────
# scripts/start.sh와 scripts/deploy_detached.sh가 사용
# 비워두면 PATH의 node를 사용 (command -v node)
# nvm 사용자는 절대경로 권장: /Users/sun/.nvm/versions/node/vXX.YY.ZZ/bin/node
NODE_BIN=
