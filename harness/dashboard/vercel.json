{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/health",        "destination": "http://91.99.58.70/health" },
    { "source": "/auth/:path*",   "destination": "http://91.99.58.70/auth/:path*" },
    { "source": "/api/:path*",    "destination": "http://91.99.58.70/api/:path*" },
    { "source": "/ws",            "destination": "http://91.99.58.70/ws" },
    { "source": "/(.*)",          "destination": "/index.html" }
  ]
}
