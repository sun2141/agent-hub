{
  "name": "agent-harness",
  "version": "1.0.0",
  "description": "Claude Code 에이전트 오케스트레이션 하네스",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:bg": "bash scripts/start.sh",
    "stop": "bash scripts/start.sh stop",
