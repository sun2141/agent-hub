{
  "_comment": "GitHub 저장소 → Google Drive 폴더 매핑 설정",
  "_instructions": "drive_folder_id는 Drive URL에서 folders/ 뒤의 값. sync_paths가 비어있으면 전체 동기화.",
  "repositories": {
    "sun2141/agent-hub": {
      "drive_folder_id": "${GOOGLE_DRIVE_FOLDER_ID}",
      "sync_paths": [
        "execution/",
        "directives/",
        "config/"
      ],
      "exclude_patterns": [
        "*.pyc",
        "__pycache__/",
        ".tmp/",
        ".venv/",
        "node_modules/",
        ".git/",
        "*.log",
        ".env"
      ],
      "description": "Agent Hub - 메인 저장소"
    },
    "sun2141/palmoni": {
      "drive_folder_id": "${GOOGLE_DRIVE_FOLDER_ID_PALMONI}",
      "sync_paths": [
        "src/",
        "api/",
        "public/"
      ],
      "exclude_patterns": [
        "*.pyc",
        "node_modules/",
        ".next/",
        ".vercel/",
        ".env*"
      ],
      "description": "Palmoni 기도앱"
    }
  },
  "defaults": {
    "max_file_size_mb": 50,
    "retry_attempts": 3,
    "retry_backoff_seconds": [1, 2, 4],
    "sync_on_events": ["push", "release"]
  }
}
