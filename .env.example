# GitHub-Drive Sync 에이전트 환경 변수 템플릿
# 이 파일을 .env로 복사하고 실제 값을 입력하세요: cp .env.example .env

# ─── GitHub ──────────────────────────────────────────────────────
# Webhook 서명 검증용 시크릿 (GitHub Webhook 설정 시 입력한 값과 동일하게)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub API 토큰 (선택, 없으면 rate limit 60 req/hr → 있으면 5000 req/hr)
# 권한: Contents (read)
GITHUB_TOKEN=ghp_your_github_token_here

# ─── Google Drive ─────────────────────────────────────────────────
# 동기화 대상 Drive 폴더 ID (Drive URL: .../folders/{ID})
# grace-ai (agent-hub) 저장소 대상 폴더
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# palmoni 저장소 대상 폴더
GOOGLE_DRIVE_FOLDER_ID_PALMONI=your_palmoni_drive_folder_id_here

# ─── Telegram ────────────────────────────────────────────────────
# 텔레그램 봇 토큰 (@BotFather에서 발급)
TELEGRAM_BOT_TOKEN=8580472888:your_bot_token_here

# 알림 받을 채팅 ID (@userinfobot으로 확인)
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── 서버 설정 ──────────────────────────────────────────────────
# Webhook 서버 포트 (기본: 8080)
WEBHOOK_PORT=8080

# ─── Drive 폴링 설정 ─────────────────────────────────────────────
# Drive 변경 감지 폴링 간격 (초, 기본: 300 = 5분)
# 짧을수록 더 빠른 감지, API 쿼터 소모 증가
DRIVE_POLL_INTERVAL_SECONDS=300

# ─── Drive Watch API (실시간 Push Notification) ──────────────────
# 공개 HTTPS URL (VPS 도메인 or ngrok). 미설정 시 폴링 전용 모드
# 예: DRIVE_WATCH_WEBHOOK_URL=https://91.99.58.70 또는 https://your-domain.com
# DRIVE_WATCH_WEBHOOK_URL=
