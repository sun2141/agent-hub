# 대시보드 환경변수
# harness-dashboard/dashboard/.env.local 에 복사 후 사용

# 백엔드 API_KEY (harness/.env의 API_KEY와 동일하게 설정)
VITE_API_KEY=change-this-to-match-backend-api-key

# 백엔드 주소
# - 개발(로컬): 비워두면 vite proxy(localhost:3000) 사용
# - 프로덕션(Vercel): Cloudflare Tunnel URL 입력
#
# Cloudflare Tunnel URL 확인 방법:
#   cd /Users/sun/agent-hub/harness
#   npm run tunnel:quick   ← 터미널에 출력된 URL 복사
#   (또는 named tunnel URL: https://<id>.cfargotunnel.com)
#
# ⚠️  반드시 https:// 로 시작해야 함 (Vercel은 HTTPS 전용)
VITE_API_BASE=https://your-tunnel-id.cfargotunnel.com
