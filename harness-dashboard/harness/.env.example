# ─── 서버 ───────────────────────────────────────────
PORT=3000
BIND_HOST=0.0.0.0

# 최소 32자 랜덤 문자열 (생성: openssl rand -hex 32)
API_KEY=change-this-to-a-random-32char-string

# ─── Telegram ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ─── Claude Code CLI ─────────────────────────────────
CLAUDE_CLI_PATH=/Users/sun/.nvm/versions/node/v22.14.0/bin/claude
CLAUDE_CONFIG_DIR=/Users/sun/agent-hub/harness-dashboard/harness/.claude
CLAUDE_MODEL=claude-sonnet-4-5

# ─── 파이프라인 ───────────────────────────────────────
# 기본 최대 라운드 수 (1~5 권장)
MAX_ROUNDS=3

# ─── 대시보드 접근 제어 ────────────────────────────────
# 특정 origin만 허용하려면 설정 (비워두면 모든 origin 허용)
# ALLOWED_ORIGIN=http://localhost:5173

# 대시보드 비밀번호 잠금 (설정하면 접속 시 비밀번호 요구)
# 비워두면 잠금 없이 바로 접근 가능
# DASHBOARD_PASSWORD=your-secure-password

# 세션 암호화 키 (설정 권장, 미설정 시 서버 재시작마다 세션 초기화)
# SESSION_SECRET=your-secret-key-min-32-chars

# ─── GitHub (프로젝트 생성 기능용, 선택) ──────────────
# GITHUB_TOKEN=ghp_xxxx
# GITHUB_USER=sun2141
